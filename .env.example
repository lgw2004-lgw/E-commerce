# Copy to .env and fill in your own credentials. Never commit real keys.
# LLM and retrieval models can use different service providers.
LLM_MODEL_NAME=
LLM_API_BASE=
LLM_API_KEY=

# Alibaba Cloud Model Studio: copy your own API Host from its console.
# Replace YOUR_WORKSPACE and the region to match the API key.
DASHSCOPE_API_KEY=
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_API_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/embeddings
RERANKER_MODEL_NAME=qwen3-rerank
RERANKER_API_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# Optional xAI Grok provider; can also be configured in the Create Model form.
XAI_API_KEY=
XAI_API_BASE=https://api.x.ai/v1

# Yuque read-only MCP bridge (local port 5671). Token stays in this file.
YUQUE_TOKEN=
YUQUE_API_BASE=https://www.yuque.com/api/v2
YUQUE_DOC_URL=
